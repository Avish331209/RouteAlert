# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Application Security
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-must-be-changed

# Database Configuration
DATABASE_PATH=routealert.db

# Optional Initial Admin Setup (used by database initialization if specified)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin_password_here
